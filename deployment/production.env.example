KNOWLEDGE_BASE_PATH=/app/knowledge-base
STORAGE_PATH=/app/storage
DATABASE_URL=sqlite:////app/storage/document_registry.db
CHUNK_STORAGE_PATH=/app/storage/chunks
MEDIA_OVERRIDES_PATH=/app/config/media_overrides.json
CHUNK_OVERRIDES_PATH=/app/config/chunking_overrides.json
LEGACY_CACHE_PATH=/app/storage/cache/legacy
OCR_CACHE_PATH=/app/storage/ocr
OCR_IMPORT_PATH=/app/storage/ocr/imported
OCR_MANIFEST_PATH=/app/storage/ocr/manifest.jsonl
OCR_MONKEYOCR_ENABLED=true
MONKEYOCR_CACHE_DIR=/models/huggingface
MONKEYOCR_MODULES_CACHE_DIR=/app/storage/cache/monkeyocr/huggingface_modules
HF_MODULES_CACHE=/app/storage/cache/monkeyocr/huggingface_modules
MONKEYOCR_ELEMENT_CACHE_DIR=/app/storage/cache/monkeyocr/elements
MONKEYOCR_MODEL_CALL_JOURNAL=/app/storage/logs/monkeyocr_model_calls.jsonl
MONKEYOCR_DEVICE=cuda
LOG_LEVEL=INFO
DOCLING_ARTIFACTS_PATH=/models/docling
ROLLING_SCHEDULE_ENABLED=true
ROLLING_SCHEDULE_ROOT=/app/storage/rolling-schedules
ROLLING_SCHEDULE_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_SPREADSHEET_ID/export?format=xlsx
ROLLING_SCHEDULE_EDIT_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_SPREADSHEET_ID/edit
ROLLING_SCHEDULE_UPDATE_INTERVAL_HOURS=24
ROLLING_SCHEDULE_STALE_AFTER_HOURS=36
ROLLING_SCHEDULE_TIMEOUT_SECONDS=60
ROLLING_SCHEDULE_DOWNLOAD_RETRIES=3

RETRIEVAL_QDRANT_URL=http://127.0.0.1:6333
RETRIEVAL_COLLECTION_NAME=corporate_knowledge_chunks_v1
RETRIEVAL_DENSE_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
RETRIEVAL_DENSE_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
RETRIEVAL_DENSE_MODEL_PATH=/models/embedding
RETRIEVAL_DENSE_DIMENSION=1024
RETRIEVAL_DENSE_BATCH_SIZE=4
RETRIEVAL_DENSE_MAX_LENGTH=4096
RETRIEVAL_DENSE_DEVICE=cuda
RETRIEVAL_DENSE_DTYPE=auto
RETRIEVAL_DENSE_LOCAL_FILES_ONLY=true
RETRIEVAL_SPARSE_MODEL_ID=Qdrant/bm25
RETRIEVAL_SPARSE_MODEL_REVISION=e499a1f8d6bec960aab5533a0941bf914e70faf9
RETRIEVAL_SPARSE_LANGUAGE=russian
RETRIEVAL_SPARSE_LOCAL_FILES_ONLY=true
RETRIEVAL_SPARSE_CACHE_PATH=/models/sparse-cache
RETRIEVAL_MODEL_CACHE_PATH=/tmp/huggingface
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
RETRIEVAL_RERANKER_MODEL_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
RETRIEVAL_RERANKER_MODEL_PATH=/models/reranker
RETRIEVAL_RERANKER_BATCH_SIZE=2
RETRIEVAL_RERANKER_MAX_LENGTH=2048
RETRIEVAL_RERANKER_DEVICE=cuda
RETRIEVAL_RERANKER_DTYPE=auto
RETRIEVAL_RERANKER_LOCAL_FILES_ONLY=true
RETRIEVAL_RERANKER_CANDIDATE_LIMIT=40
RETRIEVAL_RERANKER_FINAL_TOP_K=10
RETRIEVAL_RERANKER_INCLUDE_HEADINGS=true
RETRIEVAL_RERANKER_RELEASE_DENSE_BEFORE_LOAD=false

LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
LLM_TRUST_ENV=false
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=12288
LLM_KEEP_ALIVE=60m
LLM_THINK=false
LLM_STREAM=false
# Optional output cap for controlled A/B tests. Keep unset for the current
# production behavior until answer completeness has been benchmarked.
# LLM_NUM_PREDICT=1024
LLM_GENERATION_VERSION=rag-generation-v1.0
LLM_PROMPT_VERSION=grounded-citations-v1.0

API_HOST=127.0.0.1
API_PORT=8010
API_EMBEDDING_CONCURRENCY=1
API_RERANKER_CONCURRENCY=1
# Selected after the Stage 13 production A/B: two controlled LLM slots improve
# queue wait and throughput while preserving answer quality and VRAM headroom.
API_LLM_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=2
API_MAX_QUEUE_SIZE=32
API_QUEUE_WAIT_TIMEOUT_SECONDS=300
API_METRICS_WINDOW_SIZE=1000
# Persistent aggregate request telemetry for the protected admin dashboard.
# Question text, answers and document contents are not stored.
API_TELEMETRY_STORAGE_ENABLED=true
API_TELEMETRY_DATABASE_PATH=/app/storage/telemetry/requests.db
API_TELEMETRY_RETENTION_DAYS=90
API_WARMUP_ON_STARTUP=true
API_WARMUP_RETRY_INITIAL_SECONDS=5
API_WARMUP_RETRY_MAX_SECONDS=60
API_DEFAULT_MAX_CONTEXT_TOKENS=6000
ONLYOFFICE_PUBLIC_URL=/onlyoffice
ONLYOFFICE_INTERNAL_FILE_BASE_URL=http://host.docker.internal:3001
JWT_SECRET=replace-with-a-random-64-character-secret
API_DEFAULT_MAX_CHUNKS=8
API_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
