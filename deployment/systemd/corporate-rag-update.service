[Unit]
Description=Corporate RAG incremental knowledge-base update
Requires=docker.service
After=docker.service corporate-rag.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/corporate-rag-update
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

