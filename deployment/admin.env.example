ADMIN_USERNAME=editor
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
ADMIN_UPLOAD_ROOT=/app/admin-upload
ADMIN_KNOWLEDGE_BASE_PATH=/app/knowledge-base
ADMIN_MAX_UPLOAD_BYTES=104857600
ADMIN_ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.rtf,.xlsx,.png,.jpg,.jpeg,.mp4

# SMTP account used by the frontend server. Use an application password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
KNOWLEDGE_REQUEST_RECIPIENT=knowledge-owner@example.com
# Reserved for the director's address; leave blank until it is provided.
KNOWLEDGE_REQUEST_DIRECTOR_RECIPIENT=
