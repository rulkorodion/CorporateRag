# Server-side URL used only by Next.js route handlers.
RAG_API_URL=http://127.0.0.1:8010
RAG_API_TIMEOUT_MS=190000

# Optional local editor access. Never commit real values.
ADMIN_USERNAME=editor
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
ADMIN_UPLOAD_ROOT=.admin-upload
ADMIN_KNOWLEDGE_BASE_PATH=../База Знаний
ADMIN_MAX_UPLOAD_BYTES=104857600

# Server-side email delivery for missing-document requests.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
KNOWLEDGE_REQUEST_RECIPIENT=knowledge-owner@example.com
KNOWLEDGE_REQUEST_DIRECTOR_RECIPIENT=
