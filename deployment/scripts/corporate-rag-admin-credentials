#!/usr/bin/env python3
from __future__ import annotations

import base64
import getpass
import hashlib
import os
import secrets
import sys
from pathlib import Path


target = Path(os.environ.get("CORPORATE_RAG_ADMIN_ENV", "/opt/corporate-rag/config/admin.env"))
username = sys.argv[1].strip() if len(sys.argv) > 1 else "editor"
if not username or any(character.isspace() for character in username):
    raise SystemExit("Username must be non-empty and contain no spaces")
password = getpass.getpass("Новый пароль редактора: ")
confirmation = getpass.getpass("Повторите пароль: ")
if password != confirmation:
    raise SystemExit("Пароли не совпадают")
if len(password) < 12:
    raise SystemExit("Пароль должен содержать не менее 12 символов")
rounds = 310_000
salt = secrets.token_urlsafe(18)
digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("ascii"), rounds)
encoded = base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
values = {
    "ADMIN_USERNAME": username,
    "ADMIN_PASSWORD_HASH": f"pbkdf2_sha256:{rounds}:{salt}:{encoded}",
    "ADMIN_SESSION_SECRET": secrets.token_urlsafe(48),
    "ADMIN_SESSION_TTL_SECONDS": "28800",
    "ADMIN_COOKIE_SECURE": "false",
    "ADMIN_UPLOAD_ROOT": "/app/admin-upload",
    "ADMIN_KNOWLEDGE_BASE_PATH": "/app/knowledge-base",
    "ADMIN_MAX_UPLOAD_BYTES": "104857600",
    "ADMIN_ALLOWED_EXTENSIONS": ".pdf,.docx,.doc,.rtf,.xlsx,.png,.jpg,.jpeg,.mp4",
}
existing: list[str] = target.read_text(encoding="utf-8").splitlines() if target.exists() else []
result: list[str] = []
written: set[str] = set()
for line in existing:
    key = line.split("=", 1)[0].strip() if "=" in line else ""
    if key in values:
        result.append(f"{key}={values[key]}")
        written.add(key)
    else:
        result.append(line)
for key, value in values.items():
    if key not in written:
        result.append(f"{key}={value}")
target.parent.mkdir(parents=True, exist_ok=True)
temporary = target.with_suffix(".tmp")
temporary.write_text("\n".join(result) + "\n", encoding="utf-8")
os.chmod(temporary, 0o600)
os.replace(temporary, target)
print(f"Admin credentials updated: {target}")
print(f"Username: {username}")
